<Window x:Class="SimpleDroneGCS.UI.Dialogs.PusherTestDetailsDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Pusher Test Details"
		Width="640" Height="640"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False"
		KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#0D1733"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#98F019"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <Style x:Key="PhaseRowText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border Background="#060B1A"
			BorderBrush="#2A4361"
			BorderThickness="1.5"
			CornerRadius="12">

        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource PusherTestDetails_Title}"
						   FontSize="16" FontWeight="Bold" FontFamily="Consolas"
						   Foreground="#98F019" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource PusherTestDetails_Subtitle}"
						   FontSize="10" FontFamily="Consolas"
						   Foreground="#4498F019" HorizontalAlignment="Center"
						   Margin="0,2,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
									   Text="{DynamicResource PusherTestDetails_WhyTitle}"/>
                            <TextBlock Style="{StaticResource BodyText}"
									   Text="{DynamicResource PusherTestDetails_WhyBody1}"/>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
									   Text="{DynamicResource PusherTestDetails_WhyBody2}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
									   Text="{DynamicResource PusherTestDetails_PhasesTitle}"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1." Foreground="#60A5FA" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase1}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2." Foreground="#60A5FA" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase2}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="3." Foreground="#60A5FA" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase3}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="4." Foreground="#60A5FA" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase4}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="5." Foreground="#98F019" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase5}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="6." Foreground="#98F019" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase6}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="7." Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase7}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="8." Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_Phase8}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
									   Text="{DynamicResource PusherTestDetails_ProtectTitle}"/>
                            <TextBlock Style="{StaticResource BodyText}"
									   Text="{DynamicResource PusherTestDetails_ProtectBody}"/>
                            <StackPanel Margin="12,4,0,0">
                                <TextBlock Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_ProtectItem1}"/>
                                <TextBlock Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_ProtectItem2}"/>
                                <TextBlock Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_ProtectItem3}"/>
                                <TextBlock Style="{StaticResource BodyText}"
										   Text="{DynamicResource PusherTestDetails_ProtectItem4}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1C0A0A" BorderBrush="#7F1D1D"
							BorderThickness="1" CornerRadius="8" Padding="14,12"
							Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock FontFamily="Consolas" FontSize="11" FontWeight="Bold"
									   Foreground="#EF4444" Margin="0,0,0,6"
									   Text="{DynamicResource PusherTestDetails_CrashTitle}"/>
                            <TextBlock Style="{StaticResource BodyText}" Foreground="#FCA5A5"
									   Text="{DynamicResource PusherTestDetails_CrashBody}"/>
                            <TextBlock Style="{StaticResource BodyText}" Foreground="#FCA5A5" Margin="0,8,0,0"
									   Text="{DynamicResource PusherTestDetails_CrashAction}"/>
                            <StackPanel Margin="12,4,0,0">
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#FCA5A5" FontWeight="Bold"
										   Text="{DynamicResource PusherTestDetails_CrashItem1}"/>
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#FCA5A5" FontWeight="Bold"
										   Text="{DynamicResource PusherTestDetails_CrashItem2}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Row="2" Height="1" Fill="#1A2A4361" Margin="0,4,0,0"/>

            <Button Grid.Row="3" Style="{StaticResource DialogBtn}"
					HorizontalAlignment="Right"
					Margin="0,12,0,0"
					Background="#0D1733"
					BorderBrush="#2A4361"
					Foreground="#94A3B8"
					Content="{DynamicResource PusherTestDetails_BtnOk}"
					Click="CloseBtn_Click"/>
        </Grid>
    </Border>
</Window>
