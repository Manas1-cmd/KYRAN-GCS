<Window x:Class="SimpleDroneGCS.UI.Dialogs.PusherTestWarningDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Pusher Test"
		Width="540" SizeToContent="Height"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False"
		KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParamCard" TargetType="Border">
            <Setter Property="Background" Value="#0D1733"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Window.Resources>

    <Border Background="#060B1A"
			BorderBrush="#2A4361"
			BorderThickness="1.5"
			CornerRadius="12">

        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource PusherTest_Title}"
						   FontSize="16" FontWeight="Bold" FontFamily="Consolas"
						   Foreground="#98F019" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource PusherTest_Subtitle}"
						   FontSize="10" FontFamily="Consolas"
						   Foreground="#4498F019" HorizontalAlignment="Center"
						   Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#1C0A0A" BorderBrush="#7F1D1D"
					BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⚠  " Foreground="#EF4444" FontSize="13" FontWeight="Bold"
							   VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PusherTest_PropWarning}"
							   Foreground="#EF4444" FontFamily="Consolas" FontSize="11"
							   FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource ParamCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource PusherTest_TempChange}"
							   FontFamily="Consolas" FontSize="9"
							   Foreground="#6B7280" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="FunctionParamLabel"
								   Text="SERVO_FUNCTION"
								   FontFamily="Consolas" FontSize="11"
								   Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="FunctionOldText" Text="70"
									   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
									   Foreground="#60A5FA" Width="50"/>
                            <TextBlock Text="→" FontFamily="Consolas" FontSize="13"
									   Foreground="#6B7280" Margin="0,0,8,0"/>
                            <TextBlock Text="0" FontFamily="Consolas" FontSize="13"
									   FontWeight="Bold" Foreground="#EAB308" Width="50"/>
                            <TextBlock Text="→" FontFamily="Consolas" FontSize="13"
									   Foreground="#6B7280" Margin="0,0,8,0"/>
                            <TextBlock x:Name="FunctionRestoreText" Text="70"
									   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
									   Foreground="#98F019"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TrimParamLabel"
								   Text="SERVO_TRIM"
								   FontFamily="Consolas" FontSize="11"
								   Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="orig" FontFamily="Consolas" FontSize="13"
									   FontWeight="Bold" Foreground="#60A5FA" Width="50"/>
                            <TextBlock Text="→" FontFamily="Consolas" FontSize="13"
									   Foreground="#6B7280" Margin="0,0,8,0"/>
                            <TextBlock Text="1000" FontFamily="Consolas" FontSize="13"
									   FontWeight="Bold" Foreground="#EAB308" Width="50"/>
                            <TextBlock Text="→" FontFamily="Consolas" FontSize="13"
									   Foreground="#6B7280" Margin="0,0,8,0"/>
                            <TextBlock Text="orig" FontFamily="Consolas" FontSize="13"
									   FontWeight="Bold" Foreground="#98F019"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#0D2B1A" BorderBrush="#166534"
					BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ⓘ  " Foreground="#98F019" FontSize="13"
							   VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PusherTest_ThrottleTip}"
							   TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
							   Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <CheckBox Grid.Row="4" x:Name="HideWarningCheckBox"
					  Margin="0,12,0,0"
					  FontFamily="Consolas" FontSize="11"
					  Foreground="#94A3B8"
					  Content="{DynamicResource PusherTest_HideWarning}"/>

            <Rectangle Grid.Row="5" Height="1" Fill="#1A2A4361" Margin="0,14,0,0"/>

            <Grid Grid.Row="6" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="DetailsBtn"
						Style="{StaticResource DialogBtn}"
						Background="Transparent"
						BorderBrush="#2A4361"
						Foreground="#94A3B8"
						Content="{DynamicResource PusherTest_DetailsBtn}"
						Click="DetailsBtn_Click"/>

                <Button Grid.Column="2" x:Name="CancelBtn"
						Style="{StaticResource DialogBtn}"
						Background="Transparent"
						BorderBrush="#4B5563"
						Foreground="#94A3B8"
						Margin="0,0,8,0"
						Content="{DynamicResource PusherTest_BtnCancel}"
						Click="CancelBtn_Click"/>

                <Button Grid.Column="3" x:Name="StartBtn"
						Style="{StaticResource DialogBtn}"
						Background="#0D2B1A"
						BorderBrush="#166534"
						Foreground="#98F019"
						Content="{DynamicResource PusherTest_BtnStart}"
						Click="StartBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
