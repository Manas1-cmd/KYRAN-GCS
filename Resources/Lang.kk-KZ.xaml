    <!-- Pusher Test Details Dialog -->
    <sys:String x:Key="PusherTestDetails_Title">ПАРАМЕТРЛЕР БИI</sys:String>
    <sys:String x:Key="PusherTestDetails_Subtitle">ArduPilot қорғанысын айналып өту жолы</sys:String>

    <sys:String x:Key="PusherTestDetails_WhyTitle">БҰЛ НЕГЕ КЕРЕК</sys:String>
    <sys:String x:Key="PusherTestDetails_WhyBody1">ArduPilot DO_SET_SERVO командасын белсенді функциясы бар арналар үшін (Throttle, Motor1-4, элерондар, т.б.) "Channel X is already in use" хабарламасымен блоктайды — бұл құжатталған әрекет, ұшу кезіндегі кездейсоқ оверрайдтан қорғау.</sys:String>
    <sys:String x:Key="PusherTestDetails_WhyBody2">QuadPlane pusher моторы AP_Motors құрамына кірмейді — сондықтан DO_MOTOR_TEST оны тексермейді. Mission Planner мен QGroundControl бұл мәселеге шешімі жоқ.</sys:String>

    <sys:String x:Key="PusherTestDetails_PhasesTitle">БИ НЕ ICTEЙДI — 8 ФАЗА</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase1">SERVO_TRIM түпнұсқасын оқимыз — қалпына келтіру үшін кэштейміз</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase2">SET SERVO_TRIM=1000 — функция ауысқанда арна 1500μs-ке секірмеуі үшін жұмсақ нүкте</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase3">SET SERVO_FUNCTION=0 (Disabled) — енді DO_SET_SERVO рұқсат етіледі</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase4">DO_SET_SERVO 1000μs + 1.5с күтеміз — ESC arming кезеңі</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase5">DO_SET_SERVO target — мотор айналады</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase6">PWM-ді әр 400мс сайын duration ішінде жаңарту</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase7">Тоқтату → SERVO_FUNCTION = orig (қалпына келтіру)</sys:String>
    <sys:String x:Key="PusherTestDetails_Phase8">SERVO_TRIM = orig (қалпына келтіру)</sys:String>

    <sys:String x:Key="PusherTestDetails_ProtectTitle">КОНФИГУРАЦИЯНЫ ЖОҒАЛТУДАН ҚОРҒАУ</sys:String>
    <sys:String x:Key="PusherTestDetails_ProtectBody">Параметрлер автоматты түрде қалпына келтіріледі:</sys:String>
    <sys:String x:Key="PusherTestDetails_ProtectItem1">• тесттің қалыпты аяқталуы кезінде</sys:String>
    <sys:String x:Key="PusherTestDetails_ProtectItem2">• Тоқтату басылған кезде</sys:String>
    <sys:String x:Key="PusherTestDetails_ProtectItem3">• Motor Test диалогын жабу кезінде</sys:String>
    <sys:String x:Key="PusherTestDetails_ProtectItem4">• ҰК-мен байланыс үзілген кезде</sys:String>

    <sys:String x:Key="PusherTestDetails_CrashTitle">⚠ ҚОЛДАНБА АПАТТЫ ТҮРДЕ ЖАБЫЛСА</sys:String>
    <sys:String x:Key="PusherTestDetails_CrashBody">Тест кезінде процесс өлтірілсе (taskkill, BSOD, қуатты ажырату) — параметрлер өзгертілген күйінде қалады. Pusher ұшуда жұмыс істемейді.</sys:String>
    <sys:String x:Key="PusherTestDetails_CrashAction">Mission Planner немесе Параметрлер арқылы қолмен қалпына келтіріңіз:</sys:String>
    <sys:String x:Key="PusherTestDetails_CrashItem1">• SERVO_FUNCTION = 70 (Throttle)</sys:String>
    <sys:String x:Key="PusherTestDetails_CrashItem2">• SERVO_TRIM = алдыңғы мәніңіз (әдетте 1500)</sys:String>

